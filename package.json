{
    "name": "riven-frontend",
    "private": true,
    "version": "1.0.0-beta.3",
    "type": "module",
    "packageManager": "pnpm@11.6.0",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node server.js",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "ba:generate": "pnpx @better-auth/cli generate --config ./better-auth.config.ts --output ./src/lib/server/schema/ba-auth.ts --yes",
        "db:generate": "drizzle-kit generate",
        "db:pull": "tsx ./scripts/drizzle_pull.ts",
        "db:studio": "drizzle-kit studio"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@fontsource/merriweather": "^5.2.11",
        "@fontsource/oxanium": "^5.2.8",
        "@lucide/svelte": "^1.18.0",
        "@sveltejs/adapter-node": "^5.5.4",
        "@sveltejs/kit": "^2.65.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/d3-shape": "^3.1.8",
        "@types/node": "^25.9.3",
        "@types/nprogress": "^0.2.3",
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "embla-carousel-svelte": "^8.6.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "formsnap": "^2.0.1",
        "globals": "^17.6.0",
        "layerchart": "2.0.0-next.48",
        "mdsvex": "^0.12.7",
        "prettier": "^3.8.4",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "runed": "^0.37.1",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "svelte-sonner": "^1.1.1",
        "svelte-toolbelt": "^0.10.6",
        "sveltekit-superforms": "^2.30.1",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.0",
        "tsx": "^4.22.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
        "vaul-svelte": "1.0.0-next.7",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@better-auth/passkey": "^1.6.17",
        "@internationalized/date": "^3.12.2",
        "better-auth": "^1.6.17",
        "better-sqlite3": "^12.10.0",
        "consola": "^3.4.2",
        "cookie": "^1.1.1",
        "d3-shape": "^3.2.0",
        "drizzle-orm": "^0.45.2",
        "embla-carousel-autoplay": "^8.6.0",
        "graphql-ws": "^6.0.8",
        "http-proxy": "^1.18.1",
        "mode-watcher": "^1.1.0",
        "nprogress": "^0.2.0",
        "zod": "^4.4.3"
    }
